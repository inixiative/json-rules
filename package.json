{
  "name": "@inixiative/json-rules",
  "version": "3.3.0",
  "description": "TypeScript-first JSON rules engine with intuitive syntax and detailed error messages",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "TZ=Pacific/Kiritimati bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check:catalog": "bun test test/operatorCatalog.integrity.test.ts",
    "generate:rails": "cd test/rails && prisma generate && prisma migrate diff --from-empty --to-schema schema.prisma --script -o generated/schema.sql",
    "check": "bun run generate:rails && bun run typecheck && bun run lint && bun run test",
    "prepare": "lefthook install && bun run generate:rails",
    "prepublishOnly": "bun run check && bun run build"
  },
  "keywords": [
    "json",
    "rules",
    "engine",
    "validation",
    "typescript",
    "rules-engine",
    "business-rules"
  ],
  "author": "Aron Greenspan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inixiative/json-rules.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@electric-sql/pglite": "^0.4.1",
    "@electric-sql/pglite-socket": "0.1.1",
    "@inixiative/config": "^0.5.55",
    "@inixiative/prisma-map": "^0.2.0",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@types/bun": "1.4.2",
    "@types/lodash-es": "^4.17.12",
    "lefthook": "2.1.9",
    "lodash-es": "^4.17.21",
    "prisma": "7.8.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "@prisma/client": ">=6.0.0",
    "typescript": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@prisma/client": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "dayjs": "^1.11.13",
    "fastest-levenshtein": "^1.0.16",
    "re2js": "^2.8.6"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "packageManager": "bun@1.4.2"
}
